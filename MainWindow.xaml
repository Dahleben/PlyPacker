<Window x:Class="PlyPackerGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoCAD Ply Packer" Height="680" Width="1050" Background="#F3F3F3" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Side: Data Grid & CSV Controls -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Load CSV" Width="80" Height="30" Click="BtnLoadCSV_Click" Margin="0,0,10,0"/>
                <Button Content="➕ Add Row" Width="90" Height="30" Click="BtnAddRow_Click" Margin="0,0,10,0"/>
                <Button Content="📋 Duplicate Selected" Width="130" Height="30" Click="BtnDuplicateRow_Click" Margin="0,0,10,0"/>
                <Button Content="➖ Remove Selected" Width="130" Height="30" Click="BtnRemoveRow_Click" Margin="0,0,10,0"/>
                <Button Content="Help" Width="60" Height="30" Click="BtnOpenHelp_Click" />
            </StackPanel>

            <!-- Scrollable Data Grid -->
            <DataGrid x:Name="PlyDataGrid" Grid.Row="1" AutoGenerateColumns="False" 
                      CanUserAddRows="False" CanUserDeleteRows="False" AlternatingRowBackground="#EAEAEA"
                      SelectionUnit="CellOrRowHeader" SelectionMode="Extended"
                      PreviewKeyDown="PlyDataGrid_PreviewKeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="80"/>
                    <DataGridTextColumn Header="Width" Binding="{Binding Width}" Width="80"/>
                    <DataGridTextColumn Header="Angle" Binding="{Binding Angle}" Width="80"/>
                    <DataGridCheckBoxColumn Header="Isolate" IsThreeState="False" Binding="{Binding boolIsolate}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Right Side: Parameters & Console -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Configuration Parameters -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Packing Parameters" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="95"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Sheet Size (L x W):" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtBoxLength" Grid.Column="1" Text="150" Margin="5,0"/>
                    <TextBox x:Name="TxtBoxWidth" Grid.Column="2" Text="48" Margin="5,0"/>
                    <TextBlock Text="Keep Border:" Grid.Column="3" VerticalAlignment="Center"/>
                    <CheckBox x:Name="BoolKeepBB" Grid.Column="4" IsChecked="True" Content="" VerticalAlignment="Center" Margin="5,0"/>
                </Grid>

                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Gap:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtBoxGap" Grid.Column="1" Text="0.150" Margin="5,0"/>
                </Grid>

                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Grid Step:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtBoxStep" Grid.Column="1" Text="0.125" Margin="5,0"/>
                    <TextBlock Text="Smaller numbers take longer" Grid.Column="2" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="95"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Text Size:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtBoxTxtSize" Grid.Column="1" Text="1.0" Margin="5,0"/>
                    <TextBlock Text="Rotate Text:" Grid.Column="2" VerticalAlignment="Center"/>
                    <CheckBox x:Name="BoolTxtRt" Grid.Column="3" Content="" VerticalAlignment="Center" Margin="5,0"/>
                </Grid>

                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Deadzone (T,B,L,R):" VerticalAlignment="Center" ToolTip="Top, Bottom, Left, Right"/>
                    <TextBox x:Name="TxtBoxDzTop" Grid.Column="1" Text="0.0" Margin="2,0,2,0" ToolTip="Top"/>
                    <TextBox x:Name="TxtBoxDzBottom" Grid.Column="2" Text="0.0" Margin="2,0" ToolTip="Bottom"/>
                    <TextBox x:Name="TxtBoxDzLeft" Grid.Column="3" Text="0.0" Margin="2,0" ToolTip="Left"/>
                    <TextBox x:Name="TxtBoxDzRight" Grid.Column="4" Text="0.0" Margin="2,0" ToolTip="Right"/>
                </Grid>
            </StackPanel>

            <!-- Console Log Window -->
            <GroupBox Grid.Row="1" Header="Console Log">
                <TextBox x:Name="ConsoleOutput" IsReadOnly="True" TextWrapping="Wrap" 
                         VerticalScrollBarVisibility="Auto" Background="#1E1E1E" Foreground="#D4D4D4" FontFamily="Consolas"/>
            </GroupBox>

            <!-- Generate Buttons -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Added x:Name -->
                <Button x:Name="BtnPack" Grid.Column="0" Content="PACK PLIES &amp; PREVIEW" Height="40" Background="#4CAF50" Foreground="White" 
                        FontWeight="Bold" FontSize="14" Margin="0,0,5,0" Click="BtnPack_Click"/>

                <!-- Added x:Name and set IsEnabled="False" -->
                <Button x:Name="BtnSave" Grid.Column="1" Content="SAVE TO AUTOCAD SCRIPT" Height="40" Background="#007ACC" Foreground="White" 
                        FontWeight="Bold" FontSize="14" Margin="5,0,0,0" IsEnabled="False" Click="BtnSave_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>